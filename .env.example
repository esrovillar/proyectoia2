# Qué modelo: true = LM Studio en tu máquina (gratis), false = OpenAI (con la key del curso)
USE_LOCAL_LLM=true

# Solo si USE_LOCAL_LLM=false. La key del curso te la da tu instructor
OPENAI_API_KEY=

# Opcionales (si no los pones, se usan estos valores)
# MODEL=  (por defecto: llama-3.2-3b-instruct en local, gpt-4o-mini en la nube)
# LM_STUDIO_URL=http://localhost:1234/v1
# Tope de tokens por respuesta
MAX_TOKENS=150
# Creatividad del chat: 0 = siempre lo más probable
TEMPERATURE=0.7
# Segundos de espera por llamada
TIMEOUT=30
# Reintentos ante fallos pasajeros
MAX_RETRIES=2